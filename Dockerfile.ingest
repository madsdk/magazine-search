# GPU-enabled container for the magsearch ingestion pipeline.
#
# Defaults to CUDA 12.6. Override the base image and PaddlePaddle index to
# match a different CUDA version (e.g. 11.8) via build args.
#
# Build (CUDA 12.6):
#   docker build -f Dockerfile.ingest -t magsearch-ingest .
#
# Build (CUDA 11.8):
#   docker build -f Dockerfile.ingest \
#     --build-arg CUDA_BASE=nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04 \
#     --build-arg PADDLE_INDEX=https://www.paddlepaddle.org.cn/packages/stable/cu118/ \
#     -t magsearch-ingest .
#
# Run (requires NVIDIA Container Toolkit on the host):
#   docker run --rm --gpus all \
#     -v "$PWD/input:/input" -v "$PWD/output:/output" \
#     magsearch-ingest ingest /input/byte-1985-12.pdf \
#       --title "Byte" --date 1985-12-01 --publisher "McGraw-Hill"

ARG CUDA_BASE=nvidia/cuda:12.6.0-cudnn-runtime-ubuntu24.04
FROM ${CUDA_BASE}

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# System libs:
#   python3.12, python3.12-venv — runtime + venv module (Ubuntu 24.04)
#   libgomp1                    — GNU OpenMP runtime, required by paddle at import
#   libgl1, libglib2.0-0        — required by OpenCV (pulled in by paddlex)
#   unar                        — CBR archive support; rarfile's backend
#   ccache                      — silences paddle's "no ccache" warning
#
# CBR backend: rarfile only wraps an external tool, and of the ones it probes
# (unrar, unar, 7z, 7zz, bsdtar) only unrar and unar handle solid archives —
# bsdtar and 7z raise BadRarFile partway through a solid RAR5. unar is the
# free one; swap in `unrar` (multiverse, non-free) if you prefer it.
#
# NOT unrar-free (what this image used to install): it registers /usr/bin/unrar
# via update-alternatives, so it looks right, but ubuntu:24.04 ships 0.1.3,
# whose CLI has no `p` pipe-to-stdout command and whose reply to rarfile's probe
# (`unrar -inul -?`) is exit 64. rarfile then finds no working tool and every
# CBR ingest fails with "RarCannotExec: Cannot find working tool".
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3.12 python3.12-venv \
      libgomp1 \
      libgl1 libglib2.0-0 \
      unar ccache \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Isolated venv keeps us out of PEP 668's externally-managed system Python.
ENV VIRTUAL_ENV=/opt/venv
RUN python3.12 -m venv "$VIRTUAL_ENV"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
RUN pip install --upgrade pip

# Install paddlepaddle-gpu from PaddlePaddle's own index. PyPI's
# `paddlepaddle-gpu` is pinned to 2.x and is incompatible with paddleocr 3.x
# (missing AnalysisConfig.set_optimization_level).
ARG PADDLE_INDEX=https://www.paddlepaddle.org.cn/packages/stable/cu126/
ARG PADDLE_VERSION=3.3.1
# Use --extra-index-url so pip still queries PyPI for transitive deps (httpx,
# numpy, etc.). With `-i` pip would look for *every* package on PaddlePaddle's
# index, including PyPI packages it doesn't mirror, producing noisy DNS-retry
# warnings.
RUN pip install "paddlepaddle-gpu==${PADDLE_VERSION}" --extra-index-url "${PADDLE_INDEX}"

# paddleocr only declares paddlex as a hard dep — installing it here, before
# magsearch, avoids the [ocr] extra trying to pull the CPU `paddlepaddle`
# package (which would conflict with paddlepaddle-gpu).
RUN pip install "paddleocr>=3.0"

WORKDIR /app
COPY pyproject.toml ./
COPY src/ ./src/
COPY alembic.ini ./
COPY alembic/ ./alembic/

# [ingest] only (PyMuPDF + rarfile), deliberately not [ocr] — paddleocr +
# paddlepaddle-gpu are already in place from the layers above, and the [ocr]
# extra would pull the CPU `paddlepaddle` wheel on top of them.
RUN pip install ".[ingest]"

RUN mkdir -p /input /output
ENV MAGSEARCH_BUNDLES_DIR=/output

ENTRYPOINT ["magsearch"]
CMD ["--help"]
